# ejs-signature-api.container.example
#
# install.sh가 아래 값을 실제 환경에 맞게 치환한다.
#   - 홈 디렉터리 경로
#   - 이미지 참조 (digest 고정)
#   - HEALTH 블록은 정적 busybox가 없으면 제거된다.
#
# 이 파일에는 실제 API_TOKEN을 절대 넣지 않는다. 토큰은 EnvironmentFile로만 주입한다.

[Unit]
Description=YouTube Signature Cipher API for Lavalink (Podman Rootless)
After=network-online.target
After=lishi-net-network.service
Requires=lishi-net-network.service

[Container]
ContainerName=ejs_signature_api
# 이미지 태그: ghcr.io/kikkia/yt-cipher:master
Image=__IMAGE_REF__
Network=lishi-net.network
PublishPort=127.0.0.1:8001:8001
EnvironmentFile=__HOME__/.config/containers/systemd/ejs-signature-api.env
Environment=OVERRIDE_PLAYER_VARIANT=IAS
Volume=ejs-signature-cache:/home/nonroot/.cache/yt-cipher:U
# __HEALTH_BEGIN__
# 이미지에 shell/curl/node가 없으므로 정적 busybox를 read-only로 마운트해 healthcheck에 사용한다.
Volume=__HOME__/.local/share/yt-cipher/busybox:/usr/local/bin/busybox:ro
HealthCmd=["/usr/local/bin/busybox","wget","-q","-T","4","-O","/dev/null","http://127.0.0.1:8001/metrics"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
# __HEALTH_END__
PidsLimit=256
# Podman 4.9 quadlet은 Memory= 키를 지원하지 않아 PodmanArgs로 전달한다.
PodmanArgs=--memory=512M

[Service]
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
