{
  "apps": [
    {
      "name": "lavalink",
      "script": "java",
      "args": "-jar Lavalink.jar",
      "cwd": "./lavalink",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 5000,
      "max_memory_restart": "1G",
      "error_file": "./logs/lavalink-error.log",
      "out_file": "./logs/lavalink-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
