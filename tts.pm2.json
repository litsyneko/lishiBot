{
  "apps": [
    {
      "name": "tts-bot",
      "script": "pnpm",
      "args": "start:tts",
      "cwd": "./",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 3000,
      "max_memory_restart": "512M",
      "error_file": "./logs/tts-error.log",
      "out_file": "./logs/tts-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
